# =============================================================
#  AI AGENT FOR SMART FARMING — Environment Configuration
#  IBM Cloud Lite / IBM Granite (MANDATORY)
# =============================================================

# ---------------------------------------------------------------
# IBM WATSONX.AI — GRANITE LLM (MANDATORY)
# Register free at: https://cloud.ibm.com/registration
# Project URL: https://us-south.ml.cloud.ibm.com
# ---------------------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM Granite model to use (IBM Granite 13B Instruct v2)
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Alternative Granite models (uncomment to switch):
# GRANITE_MODEL_ID=ibm/granite-8b-code-instruct
# GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# ---------------------------------------------------------------
# IBM WATSON DISCOVERY (optional — for enterprise doc retrieval)
# ---------------------------------------------------------------
WATSON_DISCOVERY_API_KEY=your_watson_discovery_api_key_here
WATSON_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
WATSON_DISCOVERY_ENV_ID=your_discovery_environment_id
WATSON_DISCOVERY_COLLECTION_ID=your_discovery_collection_id

# ---------------------------------------------------------------
# IBM WATSON LANGUAGE TRANSLATOR
# ---------------------------------------------------------------
WATSON_TRANSLATOR_API_KEY=your_watson_translator_api_key_here
WATSON_TRANSLATOR_URL=https://api.us-south.language-translator.watson.cloud.ibm.com

# ---------------------------------------------------------------
# WEATHER API — OpenWeatherMap (free tier)
# Register at: https://openweathermap.org/api
# ---------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ---------------------------------------------------------------
# AGMARKNET / MANDI PRICE API
# Government of India Agri market data (data.gov.in)
# Register at: https://data.gov.in/user/register
# ---------------------------------------------------------------
AGMARKNET_API_KEY=your_data_gov_in_api_key_here
AGMARKNET_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# ---------------------------------------------------------------
# APPLICATION SETTINGS
# ---------------------------------------------------------------
APP_NAME=Smart Farming AI Agent
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_to_a_random_secret_key_for_production

# ---------------------------------------------------------------
# RAG / VECTOR STORE SETTINGS
# ---------------------------------------------------------------
VECTOR_STORE_PATH=./data/vector_store
KNOWLEDGE_BASE_PATH=./data/knowledge_base
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5

# Embedding model (local, no API needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------
# LLM GENERATION PARAMETERS
# ---------------------------------------------------------------
MAX_NEW_TOKENS=800
MIN_NEW_TOKENS=20
TEMPERATURE=0.3
TOP_P=0.95
TOP_K=50
REPETITION_PENALTY=1.1

# ---------------------------------------------------------------
# SUPPORTED LANGUAGES
# ---------------------------------------------------------------
SUPPORTED_LANGUAGES=en,hi,mr,pa,te,ta,kn,gu,bn,or
DEFAULT_LANGUAGE=en
